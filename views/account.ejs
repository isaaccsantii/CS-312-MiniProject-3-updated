<%- include("partials/header") %>

<div class="row justify-content-center">
  <div class="col-sm-10 col-md-8 col-lg-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-1">Your account</h1>
        <p class="text-muted small mb-4">Update your user ID, name or password. Your posts move with you.</p>
        <% if (error) { %>
          <div class="alert alert-danger py-2"><%= error %></div>
        <% } %>
        <form action="/account" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label">Full name</label>
            <input type="text" class="form-control" id="name" name="name" required maxlength="255" value="<%= form.name %>" />
          </div>
          <div class="mb-3">
            <label for="user_id" class="form-label">User ID</label>
            <input type="text" class="form-control" id="user_id" name="user_id" required
                   pattern="[A-Za-z0-9_.\-]{3,30}" value="<%= form.user_id %>" />
          </div>
          <div class="mb-3">
            <label for="new_password" class="form-label">New password <span class="text-muted">(optional)</span></label>
            <input type="password" class="form-control" id="new_password" name="new_password" minlength="6" autocomplete="new-password" />
          </div>
          <hr />
          <div class="mb-3">
            <label for="current_password" class="form-label">Current password</label>
            <input type="password" class="form-control" id="current_password" name="current_password" required autocomplete="current-password" />
            <div class="form-text">Required to save any changes.</div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-brand">Save changes</button>
            <a href="/" class="btn btn-outline-secondary">Back to feed</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include("partials/footer") %>
