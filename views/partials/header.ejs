<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trailhead Blog</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <nav class="navbar navbar-dark site-nav">
    <div class="container flex-wrap gap-2">
      <a class="navbar-brand fw-bold" href="/">Trailhead Blog</a>
      <% if (currentUser) { %>
        <div class="d-flex align-items-center gap-2">
          <span class="navbar-text small d-none d-sm-inline">Signed in as <strong><%= currentUser.name %></strong></span>
          <a href="/account" class="btn btn-sm btn-outline-light">Account</a>
          <form action="/signout" method="POST" class="m-0">
            <button class="btn btn-sm btn-light">Sign out</button>
          </form>
        </div>
      <% } else { %>
        <div class="d-flex gap-2">
          <a href="/signin" class="btn btn-sm btn-outline-light">Sign in</a>
          <a href="/signup" class="btn btn-sm btn-light">Sign up</a>
        </div>
      <% } %>
    </div>
  </nav>
  <main class="container py-4">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %> alert-dismissible py-2" role="alert">
        <%= flash.text %>
      </div>
    <% } %>
